+(* Slice 1's allowance: the committed balance minus every live tentative
+   draw on the key; a draw that fits the view but not the allowance waits
+   on the holders of those draws. *)
+RECURSIVE SumDraws(_, _)
+SumDraws(U, k) ==
+  IF U = {} THEN 0
+  ELSE LET u == CHOOSE x \in U : TRUE IN draws[u][k].bal + SumDraws(U \ {u}, k)
+
+DrawHolders(t, k) == {u \in Txns \ {t} : Active(u) /\ draws[u][k].bal > 0}
+
+AllowanceBlocks(t, op) ==
+  /\ Draws(op)
+  /\ View(t)[op.k].bal >= op.a
+  /\ View(t)[op.k].bal - SumDraws(DrawHolders(t, op.k), op.k) < op.a
+
