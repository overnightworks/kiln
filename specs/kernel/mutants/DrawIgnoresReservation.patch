+RECURSIVE SumDrawn(_, _)
+SumDrawn(U, k) ==
+  IF U = {} THEN 0
+  ELSE LET u == CHOOSE x \in U : TRUE IN draws[u][k].bal + SumDrawn(U \ {u}, k)
+
 EscrowBlocked(t, k) ==
